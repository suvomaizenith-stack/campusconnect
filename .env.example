PROVIDER=gemini
# Supabase > Project Settings > Database > Connection string. Put the real value in .env only, never here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
GEMINI_API_KEY=
# Optional: change the Gemini model without touching code (default gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
NVIDIA_API_KEY=

# Public link of the deployed app (no trailing slash). Printed inside the QR codes.
APP_URL=
